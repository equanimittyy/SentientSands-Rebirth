{
  "outputStyle": "eq",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind_comment_review.sh\"",
            "if": "Bash(*git*commit*)",
            "timeout": 10,
            "statusMessage": "Checking comments"
          }
        ]
      }
    ]
  }
}
